{
  "apiVersion": "admissionregistration.k8s.io/v1",
  "kind": "ValidatingAdmissionPolicyBinding",
  "metadata": {
    "name": "recovery-operation-pod-fence.yenhubs.org",
    "uid": "recovery-operation-fence-binding-uid",
    "resourceVersion": "recovery-operation-fence-binding-rv-1"
  },
  "spec": {
    "policyName": "recovery-operation-pod-fence.yenhubs.org",
    "validationActions": [
      "Deny"
    ],
    "matchResources": {
      "matchPolicy": "Equivalent",
      "namespaceSelector": {
        "matchExpressions": [
          {
            "key": "kubernetes.io/metadata.name",
            "operator": "In",
            "values": [
              "hcce",
              "hcce-bot-runners"
            ]
          }
        ]
      },
      "objectSelector": {}
    }
  }
}
